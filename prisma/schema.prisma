// OmniTrust Ledger data model.
//
// Status / role / algorithm columns are String, not enum: Prisma does not support
// enums on SQLite. Allowed values are enforced as TypeScript unions in the module
// that owns each concept (lib/auth/rbac.ts, lib/crypto/registry.ts,
// lib/documents/lifecycle.ts, lib/pki/keys.ts, lib/pki/revocation.ts) and validated
// before any write.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// role: "ADMIN" | "SIGNER" | "VERIFIER" | "VIEWER" (see lib/auth/rbac.ts)
model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         String
  createdAt    DateTime        @default(now())
  documents    Document[]
  keyPairs     KeyPair[]
  certificates Certificate[]
  signatures   Signature[]
  auditEntries AuditLogEntry[]
  auditCheckpoints AuditCheckpoint[]
  anchorBatches    AnchorBatch[]
}

/// Append-only hash chain: entryHash = SHA256(prevHash + canonical serialisation of
/// this entry's own fields). See lib/audit/log.ts.
model AuditLogEntry {
  id           String   @id @default(cuid())
  seq          Int      @unique
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  targetType   String
  targetId     String
  metadataJson String
  prevHash     String
  entryHash    String
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
}

/// The key that signs audit-log checkpoints, certified by the local CA. Kept apart from the
/// CA and the Time-Stamp Authority so that no key serves two purposes.
model AuditSigner {
  id                  String               @id @default(cuid())
  issuerCaId          String
  issuerCa            CertificateAuthority @relation(fields: [issuerCaId], references: [id])
  name                String
  algorithm           String
  serialNumber        String               @unique
  certPem             String
  encryptedPrivateKey String
  expiresAt           DateTime
  status              String
  createdAt           DateTime             @default(now())
  checkpoints         AuditCheckpoint[]
}

/// A signed, time-stamped commitment to the audit chain's head: entryHash is the hash of
/// entry `seq` derived from the genesis hash. Checkpoints form their own chain through
/// prevCheckpointHash, whose uniqueness prevents two checkpoints forking from one parent.
/// See lib/pki/audit-checkpoints.ts.
model AuditCheckpoint {
  id                 String      @id @default(cuid())
  seq                Int         @unique
  entryHash          String
  prevCheckpointHash String      @unique
  checkpointHash     String      @unique
  signerId           String
  signer             AuditSigner @relation(fields: [signerId], references: [id])
  signature          Bytes
  timestampToken     Bytes?
  createdByUserId    String?
  createdBy          User?       @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime
}

/// A deployment of contracts/OmniTrustAnchor.sol. genesisHash identifies the chain instance:
/// a restarted in-memory development chain has a new genesis hash and none of the old state.
model AnchorContract {
  id           String        @id @default(cuid())
  chainId      Int
  genesisHash  String
  address      String
  deployTxHash String
  ownerAddress String
  createdAt    DateTime      @default(now())
  batches      AnchorBatch[]

  @@unique([chainId, genesisHash])
}

/// One Merkle root (RFC 6962) recorded in one transaction. Only the root and leaf count are on
/// chain; the leaves stay here. See lib/anchoring/service.ts.
model AnchorBatch {
  id              String         @id @default(cuid())
  contractId      String
  contract        AnchorContract @relation(fields: [contractId], references: [id])
  root            String         @unique
  leafCount       Int
  txHash          String         @unique
  blockNumber     Int
  blockTimestamp  DateTime
  createdByUserId String?
  createdBy       User?          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())
  leaves          AnchorLeaf[]
}

/// kind: "SIGNATURE" | "AUDIT_CHECKPOINT". commitment: hex SHA-256 over identifiers and hashes of
/// the target, recomputed at verification time. An item is anchored at most once.
model AnchorLeaf {
  id         String      @id @default(cuid())
  batchId    String
  batch      AnchorBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  index      Int
  kind       String
  targetId   String
  commitment String

  @@unique([batchId, index])
  // A commitment may appear in more than one batch: a development chain that restarts leaves its
  // anchors behind, and the same signature then has to be anchored again on the new chain.
  @@unique([batchId, kind, targetId])
  @@index([kind, targetId])
}

/// Singleton, seeded once. `algorithm` is not in the spec's field list but is required:
/// the CA's signing algorithm must be resolved through the orchestrator rather than
/// hard-coded anywhere, per Section 2 rule 2.
model CertificateAuthority {
  id                   String               @id @default(cuid())
  name                 String
  algorithm            String
  certPem              String
  encryptedPrivateKey  String
  createdAt            DateTime             @default(now())
  issued               Certificate[]
  revocationLists      RevocationList[]
  timestampAuthorities TimestampAuthority[]
  auditSigners         AuditSigner[]
}

/// status: key lifecycle state, Figure 7 / NIST SP 800-57 (see lib/pki/keys.ts)
model KeyPair {
  id                  String        @id @default(cuid())
  ownerUserId         String
  owner               User          @relation(fields: [ownerUserId], references: [id])
  algorithm           String
  publicKeyPem        String
  encryptedPrivateKey String
  status              String
  createdAt           DateTime      @default(now())
  rotatedAt           DateTime?
  revokedAt           DateTime?
  certificates        Certificate[]

  @@index([ownerUserId])
}

/// status: certificate lifecycle state, Figure 6 (see lib/pki/keys.ts).
/// revocationReason: an RFC 5280 section 5.3.1 reason code name (see lib/pki/revocation.ts).
/// invalidityDate: RFC 5280 section 5.3.2, when the key is known or suspected to have been
/// compromised or the certificate otherwise became invalid.
model Certificate {
  id                String               @id @default(cuid())
  keyPairId         String
  keyPair           KeyPair              @relation(fields: [keyPairId], references: [id])
  subjectUserId     String
  subject           User                 @relation(fields: [subjectUserId], references: [id])
  issuerCaId        String
  issuerCa          CertificateAuthority @relation(fields: [issuerCaId], references: [id])
  serialNumber      String               @unique
  algorithm         String
  certPem           String
  issuedAt          DateTime             @default(now())
  expiresAt         DateTime
  status            String
  revokedAt         DateTime?
  revocationReason  String?
  invalidityDate    DateTime?
  revocationComment String?
  signatures        Signature[]

  @@index([subjectUserId])
  @@index([status])
}

/// A certificate revocation list issued and signed by the local CA (RFC 5280 section 5).
/// Stored exactly as signed. The newest list is the authoritative revocation evidence
/// used during verification, after its signature and freshness have been checked.
model RevocationList {
  id         String               @id @default(cuid())
  issuerCaId String
  issuerCa   CertificateAuthority @relation(fields: [issuerCaId], references: [id])
  crlNumber  Int                  @unique
  thisUpdate DateTime
  nextUpdate DateTime
  der        Bytes
  createdAt  DateTime             @default(now())
}

/// The local RFC 3161 Time-Stamp Authority. Its certificate is issued by the local CA with
/// a critical id-kp-timeStamping extended key usage, and can be revoked like any other.
model TimestampAuthority {
  id                  String               @id @default(cuid())
  issuerCaId          String
  issuerCa            CertificateAuthority @relation(fields: [issuerCaId], references: [id])
  name                String
  algorithm           String
  policyOid           String
  serialNumber        String               @unique
  certPem             String
  encryptedPrivateKey String
  expiresAt           DateTime
  status              String
  revokedAt           DateTime?
  revocationReason    String?
  invalidityDate      DateTime?
  createdAt           DateTime             @default(now())
}

/// status: document lifecycle state, Figure 4 (see lib/documents/lifecycle.ts)
model Document {
  id          String            @id @default(cuid())
  ownerUserId String
  owner       User              @relation(fields: [ownerUserId], references: [id])
  filename    String
  mimeType    String
  storagePath String
  currentHash String
  status      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    DocumentVersion[]

  @@index([ownerUserId])
  @@index([currentHash])
}

model DocumentVersion {
  id            String      @id @default(cuid())
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  storagePath   String
  hash          String
  createdAt     DateTime    @default(now())
  signatures    Signature[]

  @@unique([documentId, versionNumber])
}

/// One signature per document version: the version's `hash` is the payload that was
/// signed (see the decisions log in PROGRESS.md).
///
/// timestampToken: an RFC 3161 TimeStampToken over SHA-256 of signatureBytes (RFC 3161
/// Appendix A). It is the proof that the signature existed at its genTime; timestampedAt
/// copies that time for listings only and is never trusted by verification.
///
/// cmsSignature: a detached CMS SignedData (RFC 5652) made in the same signing action by the
/// same key over signed attributes that carry a digest of the document bytes, with a
/// time-stamp over its own signature value. Exported for verification with external tools.
/// Null for signatures made before CMS export existed.
model Signature {
  id                String          @id @default(cuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  certificateId     String
  certificate       Certificate     @relation(fields: [certificateId], references: [id])
  algorithm         String
  signatureBytes    Bytes
  signedAt          DateTime        @default(now())
  signedByUserId    String
  signedBy          User            @relation(fields: [signedByUserId], references: [id])
  timestampToken    Bytes?
  timestampedAt     DateTime?
  cmsSignature      Bytes?

  @@unique([documentVersionId])
  @@index([certificateId])
}
