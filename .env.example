# Copy to .env, or run `npm run setup` which generates a .env with fresh secrets.

# SQLite database file, relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Signs the session JWT. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-32-random-bytes-hex"

# AES-256-GCM key used to encrypt private keys at rest. A local file, NOT an HSM or KMS
# (demo-grade: see the limitations section of README.md). Created by `npm run setup`.
MASTER_KEY_PATH="./storage/keys/master.key"

# Root directory for encrypted document blobs.
STORAGE_ROOT="./storage"
