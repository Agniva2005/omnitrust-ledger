# Copy to .env, or run `npm run setup` which generates a .env with fresh secrets.

# SQLite database file, relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Signs the session JWT. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-32-random-bytes-hex"

# AES-256-GCM key used to encrypt private keys at rest. A local file, NOT an HSM or KMS
# (demo-grade: see the limitations section of README.md). Created by `npm run setup`.
MASTER_KEY_PATH="./storage/keys/master.key"

# Root directory for encrypted document blobs.
STORAGE_ROOT="./storage"

# Optional: the algorithms the local trust services sign with. Each binds when the service is first
# created (for the CA, during `npm run setup`); an existing service keeps its algorithm. The default
# for all three is ECDSA_P256. PKI_CA_ALGORITHM must be able to sign X.509 certificates, so ML_DSA_65
# gives a post-quantum root CA; the TSA and audit signer accept any registered algorithm, including
# the hybrid MLDSA65_ECDSA_P256. See "Post-quantum trust services" in README.md.
# PKI_CA_ALGORITHM="ML_DSA_65"
# PKI_TSA_ALGORITHM="ML_DSA_65"
# PKI_AUDIT_SIGNER_ALGORITHM="ML_DSA_65"
